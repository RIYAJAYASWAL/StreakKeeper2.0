generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HabitCategory {
  HEALTH
  FITNESS
  LEARNING
  MINDFULNESS
  PRODUCTIVITY
  QUIT_BAD_HABIT
  OTHER
}

enum FrequencyType {
  DAILY
  WEEKLY
  CUSTOM
}

enum CheckInStatus {
  COMPLETED
  FROZEN
  MISSED
}

enum FreezeReasonTag {
  SICK
  TRAVEL
  WORK
  POOR_SLEEP
  FORGOT
  STRESS
  OTHER
}

enum JournalVisibility {
  PUBLIC
  PRIVATE
}

enum GroupType {
  FRIENDS
  HABIT
}

enum GroupRole {
  OWNER
  MEMBER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

model User {
  id               String       @id @default(cuid())
  email            String       @unique
  passwordHash     String?
  name             String?
  timezone         String       @default("UTC")
  xp               Int          @default(0)
  level            Int          @default(1)
  freezesRemaining Int          @default(3)
  freezesResetAt   DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  sessions         Session[]

  habits           Habit[]
  checkIns         CheckIn[]
  freezeUses       FreezeUse[]
  journals         Journal[]
  journalReads     JournalRead[]
  createdGroups    Group[]        @relation("GroupCreator")
  groupMemberships GroupMember[]
  sentFriendships  Friendship[]   @relation("FriendshipRequester")
  recvFriendships  Friendship[]   @relation("FriendshipAddressee")
  aiInsights       AiInsight[]
  xpEvents         XpEvent[]

  @@index([email])
  @@index([createdAt])
  @@index([level])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Habit {
  id              String        @id @default(cuid())
  userId          String
  name            String
  category        HabitCategory
  description     String?
  frequencyType   FrequencyType @default(DAILY)
  targetPerPeriod Int?
  daysOfWeek      Int[]         @default([])
  intervalDays    Int?
  startDate       DateTime      @default(now()) @db.Date
  archivedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns        CheckIn[]
  freezeUses      FreezeUse[]
  streak          Streak?
  journals        Journal[]
  aiInsights      AiInsight[]

  @@index([userId])
  @@index([category])
  @@index([frequencyType])
  @@index([archivedAt])
  @@index([startDate])
}

model CheckIn {
  id         String        @id @default(cuid())
  habitId    String
  userId     String
  localDate  DateTime      @db.Date
  status     CheckInStatus
  note       String?
  createdAt  DateTime      @default(now())

  habit      Habit         @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  freezeUses FreezeUse[]

  @@unique([habitId, localDate])
  @@index([habitId])
  @@index([userId])
  @@index([localDate])
  @@index([status])
  @@index([userId, localDate])
}

model FreezeUse {
  id         String          @id @default(cuid())
  userId     String
  habitId    String
  checkInId  String?
  localDate  DateTime        @db.Date
  reasonTag  FreezeReasonTag
  note       String          @db.VarChar(500)
  createdAt  DateTime        @default(now())

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit      Habit           @relation(fields: [habitId], references: [id], onDelete: Cascade)
  checkIn    CheckIn?        @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([habitId])
  @@index([checkInId])
  @@index([localDate])
  @@index([reasonTag])
}

model Streak {
  id              String    @id @default(cuid())
  habitId         String    @unique
  current         Int       @default(0)
  longest         Int       @default(0)
  lastCountedDate DateTime? @db.Date
  updatedAt       DateTime  @updatedAt

  habit           Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([habitId])
  @@index([current])
}

model Journal {
  id         String            @id @default(cuid())
  authorId   String
  habitId    String?
  category   HabitCategory
  title      String
  body       String            @db.Text
  visibility JournalVisibility @default(PRIVATE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  habit      Habit?            @relation(fields: [habitId], references: [id], onDelete: SetNull)
  reads      JournalRead[]

  @@index([authorId])
  @@index([habitId])
  @@index([visibility])
  @@index([category])
  @@index([createdAt])
  @@index([visibility, createdAt])
}

model JournalRead {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  localDate DateTime @db.Date
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal   Journal  @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId, localDate])
  @@index([userId])
  @@index([journalId])
  @@index([localDate])
}

model Group {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    HabitCategory?
  type        GroupType
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     GroupMember[]

  @@index([createdById])
  @@index([type])
  @@index([category])
}

model GroupMember {
  groupId  String
  userId   String
  role     GroupRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@index([role])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
  @@index([status])
}

model AiInsight {
  id           String    @id @default(cuid())
  userId       String
  habitId      String?
  content      String    @db.Text
  basedOnFrom  DateTime  @db.Date
  basedOnTo    DateTime  @db.Date
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit        Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([habitId])
  @@index([createdAt])
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  amount    Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}
