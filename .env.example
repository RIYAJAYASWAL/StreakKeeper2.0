# Neon PostgreSQL Pooled Connection (used by application queries via connection pooling)
DATABASE_URL="postgresql://neondb_owner:npg_sample_pass@ep-sample-pooler.us-east-2.aws.neon.tech/streakkeeper?sslmode=require"

# Neon PostgreSQL Direct Connection (used for migrations and schema introspection)
DIRECT_URL="postgresql://neondb_owner:npg_sample_pass@ep-sample.us-east-2.aws.neon.tech/streakkeeper?sslmode=require"

# Auth & Security
AUTH_SECRET="streakkeeper-dev-auth-secret-key-at-least-32-chars-long"
GOOGLE_CLIENT_ID="google-client-id-placeholder"
GOOGLE_CLIENT_SECRET="google-client-secret-placeholder"
CRON_SECRET="streakkeeper-dev-cron-secret"
AI_API_KEY="dummy-ai-api-key-for-local-dev"
